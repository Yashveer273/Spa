{
  "name": "apkaspa-website",
  "version": "1.0.0",
  "private": true,
  "description": "AAPNA SPA website (React + TypeScript) with a Node + MongoDB backend and Cashfree checkout",
  "main": "backend/server.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "node backend/server.js",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "start": "node backend/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "mongodb": "^6.21.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
