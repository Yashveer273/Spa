# Copy this file to ".env" and fill it in. Restart the server (npm start) after editing.
# NEVER share .env or upload it anywhere public.

# ---- MongoDB (required) ----
# Local MongoDB on this computer:
MONGODB_URI=mongodb://127.0.0.1:27017/apkaspa
# MongoDB Atlas (cloud) – paste the string from Atlas → Connect → Drivers, and add /apkaspa before the "?":
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/apkaspa?retryWrites=true&w=majority

# ---- Admin dashboard (/admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password-here

# ---- Cashfree payments (used by the Pay buttons) ----
# Cashfree Merchant Dashboard → Developers → API Keys. Test keys start with TEST… / cfsk_ma_test_…
# Keep CASHFREE_ENV=sandbox while testing; set it to production with your live keys after KYC.
CASHFREE_APP_ID=TESTxxxxxxxxxxxxxxxx
CASHFREE_SECRET_KEY=cfsk_ma_test_xxxxxxxxxxxxxxxx
CASHFREE_ENV=sandbox
# Optional: your site's address for "return after payment" (normally detected automatically)
# SITE_URL=https://your-site.vercel.app

# ---- Razorpay (optional alternative) ----
# Only used if Cashfree keys are missing, or if you set PAYMENT_PROVIDER=razorpay.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=choose-a-webhook-secret
# PAYMENT_PROVIDER=cashfree

PORT=5500

# Optional: secret used to sign login cookies. If left out, one is generated
# automatically in data/session-secret. Set it yourself when hosting.
# SESSION_SECRET=paste-a-long-random-string-here

# Optional: if your network's DNS can't look up a mongodb+srv:// address, the server
# automatically retries with these public DNS servers (default shown).
# DNS_SERVERS=8.8.8.8,1.1.1.1
